{
  "openapi": "3.0.3",
  "info": {
    "title": "LJ Web Management API",
    "version": "1.0.0",
    "description": "Free, read-only JSON API for LJ Web Management, a company that builds custom, done-for-you AI automation systems for businesses. Look up the automation catalog by industry or business function, platform solutions, integrations, the FAQ, and the glossary. No authentication. Every response is static JSON regenerated on each site build. Errors use the Error schema. Plain-text references for AI systems are also available at /llms.txt and /llms-full.txt, and every HTML page has a Markdown version (send Accept: text/markdown).",
    "contact": {
      "name": "LJ Web Management",
      "email": "info@ljwebmanagement.com",
      "url": "https://www.ljwebmanagement.com/contactus/"
    },
    "termsOfService": "https://www.ljwebmanagement.com/terms-of-service/"
  },
  "externalDocs": {
    "description": "LJ Web Management developer docs",
    "url": "https://www.ljwebmanagement.com/developers/"
  },
  "servers": [
    {
      "url": "https://www.ljwebmanagement.com"
    }
  ],
  "tags": [
    {
      "name": "catalog",
      "description": "Read-only catalog data."
    }
  ],
  "security": [],
  "paths": {
    "/api/v1/index.json": {
      "get": {
        "operationId": "getApiIndex",
        "summary": "List every API endpoint",
        "description": "Entry point for the API. Returns the name, version, documentation links, and every endpoint.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "List every API endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIndex"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/company.json": {
      "get": {
        "operationId": "getCompany",
        "summary": "Get company facts and contact details",
        "description": "Returns LJ Web Management's description, contact email, phone, postal address, booking page, and pricing model.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Get company facts and contact details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories.json": {
      "get": {
        "operationId": "listCategories",
        "summary": "List business-function categories",
        "description": "Returns the 11 business-function categories that organize the automation catalog, with counts.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "List business-function categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryList"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/{category}.json": {
      "get": {
        "operationId": "getCategory",
        "summary": "Get one category and its automations",
        "description": "Returns one business-function category and a summary of every automation in it, across all industries.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Get one category and its automations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryDetail"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "description": "Category slug from listCategories.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "enum": [
                "lead-follow-up-sales",
                "marketing-retention",
                "scheduling-dispatch",
                "customer-communication",
                "reviews-feedback",
                "billing-finance",
                "onboarding-intake",
                "hr-team",
                "compliance-documents",
                "operations-inventory",
                "reporting-analytics"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/industries.json": {
      "get": {
        "operationId": "listIndustries",
        "summary": "List industries",
        "description": "Returns the 57 industries the automation catalog covers, with counts.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "List industries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndustryList"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/industries/{industry}.json": {
