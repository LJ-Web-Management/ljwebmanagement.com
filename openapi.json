  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Error response returned for any failed /api/ request.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "description": "Error details.",
            "required": [
              "status",
              "code",
              "message",
              "hint",
              "docs"
            ],
            "properties": {
              "status": {
                "type": "integer",
                "minimum": 0,
                "description": "HTTP status code, repeated in the body."
              },
              "code": {
                "type": "string",
                "description": "Stable, machine-readable error code.",
                "enum": [
                  "not_found",
                  "method_not_allowed"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation of what went wrong."
              },
              "hint": {
                "type": "string",
                "description": "How to fix the request."
              },
              "docs": {
                "type": "string",
                "format": "uri",
                "description": "Developer documentation."
              }
            }
          }
        }
      },
      "Endpoint": {
        "type": "object",
        "description": "One API endpoint.",
        "required": [
          "operationId",
          "method",
          "path",
          "description"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "description": "Operation ID, matching openapi.json."
          },
          "method": {
            "type": "string",
            "description": "HTTP method.",
            "enum": [
              "GET"
            ]
          },
          "path": {
            "type": "string",
            "description": "Path template relative to the site root."
          },
          "description": {
            "type": "string",
            "description": "What the endpoint returns."
          }
        }
      },
      "ApiIndex": {
        "type": "object",
        "description": "Entry point listing every endpoint.",
        "required": [
          "name",
          "version",
          "description",
          "authentication",
          "docs",
          "openapi",
          "endpoints"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "API name."
          },
          "version": {
            "type": "string",
            "description": "API version."
          },
          "description": {
            "type": "string",
            "description": "What the API offers."
          },
          "authentication": {
            "type": "string",
            "description": "Authentication requirements."
          },
          "docs": {
            "type": "string",
            "format": "uri",
            "description": "Developer documentation."
          },
          "openapi": {
            "type": "string",
            "format": "uri",
            "description": "OpenAPI 3 description of this API."
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Endpoint"
            },
            "description": "Every endpoint in the API."
          }
        }
      },
      "Address": {
        "type": "object",
        "description": "Postal address.",
        "required": [
          "streetAddress",
          "addressLocality",
          "addressRegion",
          "postalCode",
          "addressCountry"
        ],
        "properties": {
          "streetAddress": {
            "type": "string",
            "description": "Street address."
          },
          "addressLocality": {
            "type": "string",
            "description": "City."
          },
          "addressRegion": {
            "type": "string",
            "description": "State."
          },
          "postalCode": {
            "type": "string",
            "description": "ZIP code."
          },
          "addressCountry": {
            "type": "string",
            "description": "ISO 3166-1 country code."
          }
        }
      },
      "Company": {
        "type": "object",
        "description": "Company facts and contact details.",
        "required": [
          "name",
          "description",
          "url",
          "email",
          "telephone",
          "address",
          "bookingUrl",
          "contactUrl",
          "pricingModel",
          "sameAs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Company name."
          },
          "description": {
            "type": "string",
            "description": "What the company does."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Website."
          },
          "email": {
            "type": "string",
            "description": "Contact email.",
            "format": "email"
          },
          "telephone": {
            "type": "string",
            "description": "Contact phone number in E.164-style format."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "bookingUrl": {
            "type": "string",
            "format": "uri",
            "description": "Page for booking a free consultation."
          },
          "contactUrl": {
            "type": "string",
            "format": "uri",
            "description": "Contact page."
          },
          "pricingModel": {
            "type": "string",
            "description": "How engagements are priced."
          },
          "sameAs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "description": "Profile URL."
            },
            "description": "Official social profiles."
          }
        }
      },
      "CategorySummary": {
        "type": "object",
        "description": "A business-function category.",
        "required": [
          "slug",
          "name",
          "summary",
          "automationCount",
          "url",
          "apiUrl"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Category slug."
          },
          "name": {
            "type": "string",
            "description": "Category name."
          },
          "summary": {
            "type": "string",
            "description": "One-sentence summary."
          },
          "automationCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of automations in the category."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HTML page for the category."
          },
          "apiUrl": {
            "type": "string",
            "format": "uri",
            "description": "JSON detail for the category."
          }
        }
      },
      "CategoryList": {
        "type": "object",
        "description": "All business-function categories.",
        "required": [
          "count",
          "categories"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of categories."
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategorySummary"
            },
            "description": "Every category."
          }
        }
      },
      "AutomationSummary": {
        "type": "object",
        "description": "Short form of an automation.",
        "required": [
          "id",
          "title",
          "industry",
          "category",
          "role",
          "summary",
          "url",
          "apiUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID: <industry>/<slug>."
          },
          "title": {
            "type": "string",
            "description": "Automation name."
          },
          "industry": {
            "type": "string",
            "description": "Industry slug."
          },
          "category": {
            "type": "string",
            "description": "Business-function category slug."
          },
          "role": {
            "type": "string",
            "description": "Job role the automation is built for."
          },
          "summary": {
            "type": "string",
            "description": "Short teaser of what it does."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HTML page for the automation."
          },
          "apiUrl": {
            "type": "string",
            "format": "uri",
            "description": "JSON for the automation's industry, which includes its full detail."
          }
        }
      },
      "Automation": {
        "type": "object",
        "description": "Full detail of a done-for-you automation.",
        "required": [
          "id",
          "slug",
          "title",
          "industry",
          "category",
          "role",
          "summary",
          "steps",
          "manualProcess",
          "tools",
          "integrations",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID: <industry>/<slug>."
          },
          "slug": {
            "type": "string",
            "description": "Automation slug, unique within its industry."
          },
          "title": {
            "type": "string",
            "description": "Automation name."
          },
          "industry": {
            "type": "string",
            "description": "Industry slug."
          },
          "category": {
            "type": "string",
            "description": "Business-function category slug."
          },
          "role": {
            "type": "string",
            "description": "Job role the automation is built for."
          },
          "summary": {
            "type": "string",
            "description": "Short teaser of what it does."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One step."
            },
            "description": "What the automation does, step by step."
          },
          "manualProcess": {
            "type": "string",
            "description": "The manual process it replaces."
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Tool description."
            },
            "description": "Tools and systems it connects."
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Integration name."
            },
            "description": "Normalized integration names, matching /api/v1/integrations.json."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HTML page for the automation."
          }
        }
      },
      "CategoryDetail": {
        "type": "object",
        "description": "A category with its automations.",
        "required": [
          "slug",
          "name",
          "summary",
          "description",
          "url",
          "automationCount",
          "automations"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Category slug."
          },
          "name": {
            "type": "string",
            "description": "Category name."
          },
          "summary": {
            "type": "string",
            "description": "One-sentence summary."
          },
          "description": {
            "type": "string",
            "description": "Longer description."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HTML page for the category."
          },
          "automationCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of automations."
          },
          "automations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AutomationSummary"
            },
            "description": "Every automation in the category."
          }
        }
      },
      "IndustrySummary": {
        "type": "object",
        "description": "An industry.",
        "required": [
          "slug",
          "name",
          "summary",
          "automationCount",
          "url",
          "apiUrl"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Industry slug."
          },
          "name": {
            "type": "string",
            "description": "Industry name."
          },
          "summary": {
            "type": "string",
            "description": "One-sentence summary."
          },
          "automationCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of automations for the industry."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HTML page for the industry."
          },
          "apiUrl": {
            "type": "string",
            "format": "uri",
            "description": "JSON detail for the industry."
          }
        }
      },
      "IndustryList": {
        "type": "object",
        "description": "All industries.",
        "required": [
          "count",
          "industries"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of industries."
          },
          "industries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndustrySummary"
            },
            "description": "Every industry."
          }
        }
      },
      "IndustryDetail": {
        "type": "object",
        "description": "An industry with the full detail of its automations.",
