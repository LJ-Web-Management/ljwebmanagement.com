    "/api/v1/solutions.json": {
      "get": {
        "operationId": "listSolutions",
        "summary": "List platform-scale solutions",
        "description": "Returns every platform solution (CRM, ERP, websites, billing, AI agents, and more) grouped by category, with features, integrations, and FAQs.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "List platform-scale solutions",
            "content": {
              "application/json": {
