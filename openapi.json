                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faq.json": {
      "get": {
        "operationId": "getFaq",
        "summary": "Get the FAQ",
        "description": "Returns every frequently asked question about pricing, process, tools, and industries, in plain text.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Get the FAQ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Faq"
                }
              }
            }
          },
          "404": {
            "description": "No resource at this path. The body explains why and links to the docs.",
