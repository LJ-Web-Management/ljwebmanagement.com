                }
              }
            }
          }
        }
      }
    },
    "/api/v1/integrations.json": {
      "get": {
        "operationId": "listIntegrations",
        "summary": "List integrations",
        "description": "Returns the tools and platforms the automations connect (for example Zapier, HubSpot, QuickBooks), with counts.",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
